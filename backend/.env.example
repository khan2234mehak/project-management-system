# =====================================================================
# Server
# =====================================================================
NODE_ENV=development
PORT=5007
CLIENT_URL=http://localhost:5173

# =====================================================================
# SQLite Database
# Path to the SQLite file. Relative paths are resolved from the backend/
# directory. Leave as default — the file is created automatically on
# first run (npm run migrate).
# =====================================================================
DB_PATH=./database/pms.sqlite

# =====================================================================
# JWT Authentication
# CHANGE THESE before any real deployment.
# =====================================================================
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# =====================================================================
# File Storage
# storage provider: "local" or "cloudinary"
# =====================================================================
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=10

# Only needed if STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================================
# Email (for verification / password reset)
# Leave blank in development — emails are logged to the console instead.
# =====================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@pms.local

# =====================================================================
# Rate Limiting
# =====================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
